<scenario>
    <robot name="$(arg robot_name)" fixed="false" self_collisions="false">
        <base_link name="Vehicle" type="compound" physics="submerged">
            <external_part name="Hull" type="model" physics="submerged" buoyant="false">
                <physical>
                    <mesh filename="parts/body/race2_body_mm.obj" scale="0.001"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="parts/body/race2_body_mm.obj" scale="0.001"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Vehicle"/>
                <look name="yellow"/>
                <mass value="25.2"/>
                <!-- <inertia xyz="1.0 10.0 10.0"/> -->
                <compound_transform rpy="3.1415926 0.0 0.0" xyz="0.0 0.0 0.0"/>
                <cg xyz="-0.456 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </external_part>

            <internal_part name="Foam" type="box" physics="floating" buoyant="true">
                <dimensions xyz="0.8 0.21 0.15"/>
                <origin rpy="0.0 0.0 0.0" xyz="-0.456 0.0 -0.15"/>
                <material name="Foam"/>
                <mass value="0.15"/>
                <look name="grey"/>
                <compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            </internal_part>

            <external_part name="Mast" type="model" physics="submerged" buoyant="true ">
                <physical>
                    <mesh filename="parts/others/new_mast.obj" scale="0.001"/>
                    <origin rpy="0.0 0.0 0.0"  xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="parts/others/new_mast.obj" scale="0.001"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Vehicle"/>
                <look name="red"/>
                <compound_transform rpy="3.1415926 0.0 0.0" xyz="-0.35 0.0 -0.1"/>
            </external_part>
         </base_link>
         

        <!-- the actual base frame  -->
        <link name="Base" type="box" physics="submerged">
            <dimensions xyz="0.01 0.02 0.01"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <material name="Neutral"/>
            <look name="Green"/>
        </link>


        <joint name="Joint1" type="fixed">
            <parent name="Vehicle"/>
            <child name="Base"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <axis xyz="1.0 0.0 0.0"/>
        </joint>


        <!-- Thruster -->
        <!-- <actuator name="ThrusterSwayStern" type="propeller">
            <link name="Base"/>
            <origin rpy="0.0 0.0 1.5707" xyz="-0.66635 0.0 -0.07535"/>
            <specs thrust_coeff="286.7" torque_coeff="0.01" max_rpm="3000.0"/>
            <propeller diameter="0.08" right="true">
                <mesh filename="parts/thruster/prop.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="red"/>
            </propeller>
        </actuator> -->

        <actuator name="ThrusterHeaveStern" type="propeller">
            <link name="Base"/>
            <origin rpy="0.0 -1.5707 0.0" xyz="-0.66635 0.0 -0.07535"/>
            <specs thrust_coeff="286.7" torque_coeff="0.01" max_rpm="3000.0"/>
            <propeller diameter="0.08" right="true">
                <mesh filename="parts/thruster/prop.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="red"/>
            </propeller>
        </actuator>

        <actuator name="ThrusterHeaveBow" type="propeller">
            <link name="Base"/>
            <origin rpy="0.0 -1.5707 0.0" xyz="-0.07535 0.0 -0.07535"/>
            <specs thrust_coeff="286.7" torque_coeff="0.01" max_rpm="3000.0"/>
            <propeller diameter="0.08" right="true">
                <mesh filename="parts/thruster/prop.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="red"/>
            </propeller>
        </actuator>

        

        <!-- ################################################################### -->
        <!-- surge port thruster -->
        <link name="surge_starboard_thruster_link" type="model" physics="submerged" buoyant="true">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <physical>
                <mesh filename="parts/thruster/duct_sim.obj" scale="0.001"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            </physical>
            <visual>
                <mesh filename="parts/thruster/duct_sim.obj" scale="0.001"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            </visual>
            <material name="Resin"/>
            <look name="red"/>
            <mass value="0.1"/>

        </link>


        <link name="surge_port_thruster_link" type="model" physics="submerged" buoyant="true">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <physical>
                <mesh filename="parts/thruster/duct_sim.obj" scale="0.001"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            </physical>
            <visual>
                <mesh filename="parts/thruster/duct_sim.obj" scale="0.001"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            </visual>
            <material name="Resin"/>
            <look name="red"/>
            <mass value="0.1"/>
        </link>
        
       
        <joint name="surge_port_servo_joint" type="revolute">
            <parent name="Base"/>
            <child name="surge_port_thruster_link"/>
            <origin rpy="1.571 0.0 -0.52" xyz="-0.86 -0.125 -0.05485"/> 
            <axis xyz="0.0 0.0 1.0"/>
            <limits min= "$(arg servo_min_ang)" max="$(arg servo_max_ang)"/>   
        </joint>

        
        <joint name="surge_starboard_servo_joint" type="revolute">
            <parent name="Base"/>
            <child name="surge_starboard_thruster_link"/>
            <origin rpy="-1.571 0.0 0.52" xyz="-0.86 0.125 -0.05485"/> 
            <axis xyz="0.0 0.0 1.0"/>
            <limits min= "$(arg servo_min_ang)" max="$(arg servo_max_ang)"/>   
        </joint>

        
        <actuator name="surge_port_servo" type="servo"> 
            <joint name="surge_port_servo_joint"/> 
            <controller position_gain="1.0" velocity_gain="1.0" max_torque="3.0" max_velocity="1.0"/>
            <initial position="0.0"/>
        </actuator> 

        <actuator name="surge_starboard_servo" type="servo"> 
            <joint name="surge_starboard_servo_joint"/> 
            <controller position_gain="1.0" velocity_gain="1.0" max_torque="3.0" max_velocity="1.0"/>
            <initial position="0.0"/>
        </actuator> 

         <actuator name="ThrusterSurgePort" type="propeller">
            <link name="surge_port_thruster_link"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            <specs thrust_coeff="350.0" torque_coeff="0.01" max_rpm="4000.0"/>

            <propeller diameter="0.08" right="true">
                <mesh filename="parts/thruster/prop.obj" scale="1.0"/>
                <material name="Resin"/>
                <look name="red"/>
            </propeller>
            <mass value="0.1"/>
        </actuator>

        <actuator name="ThrusterSurgeStarboard" type="propeller">
            <link name="surge_starboard_thruster_link"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            <specs thrust_coeff="350.0" torque_coeff="0.01" max_rpm="4000.0"/>
            <propeller diameter="0.08" right="true">
                <mesh filename="parts/thruster/prop.obj" scale="1.0"/>
                <material name="Resin"/>
                <look name="red"/>
            </propeller>
            <mass value="0.1"/>
        </actuator>

        <!-- mid section port and startboar  -->

        <link name="mid_starboard_thruster_link" type="model" physics="submerged" buoyant="true">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <physical>
                <mesh filename="parts/thruster/duct_sim.obj" scale="0.001"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            </physical>
            <visual>
                <mesh filename="parts/thruster/duct_sim.obj" scale="0.001"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            </visual>
            <material name="Resin"/>
            <look name="red"/>
            <mass value="0.1"/>

        </link>


        <link name="mid_port_thruster_link" type="model" physics="submerged" buoyant="true">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <physical>
                <mesh filename="parts/thruster/duct_sim.obj" scale="0.001"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            </physical>
            <visual>
                <mesh filename="parts/thruster/duct_sim.obj" scale="0.001"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            </visual>
            <material name="Resin"/>
            <look name="red"/>
            <mass value="0.1"/>
        </link>
        
       
        <joint name="mid_port_servo_joint" type="revolute">
            <parent name="Base"/>
            <child name="mid_port_thruster_link"/>
            <origin rpy="1.571 0.0 0.0" xyz="-0.4 -0.24 -0.05485"/> 
            <axis xyz="0.0 0.0 1.0"/>
            <limits min= "$(arg servo_min_ang)" max="$(arg servo_max_ang)"/>   
        </joint>

        <joint name="mid_starboard_servo_joint" type="revolute">
            <parent name="Base"/>
            <child name="mid_starboard_thruster_link"/>
            <origin rpy="-1.571 0.0 0.0" xyz="-0.4 0.24 -0.05485"/> 
            <axis xyz="0.0 0.0 1.0"/>
            <limits min= "$(arg servo_min_ang)" max="$(arg servo_max_ang)"/>   
        </joint>

        
        <actuator name="mid_port_servo" type="servo"> 
            <joint name="mid_port_servo_joint"/> 
            <controller position_gain="1.0" velocity_gain="1.0" max_torque="3.0" max_velocity="1.0"/>
            <initial position="0.0"/>
        </actuator> 

        <actuator name="mid_starboard_servo" type="servo"> 
            <joint name="mid_starboard_servo_joint"/> 
            <controller position_gain="1.0" velocity_gain="1.0" max_torque="3.0" max_velocity="1.0"/>
            <initial position="0.0"/>
        </actuator> 

         <actuator name="ThrusterMidPort" type="propeller">
            <link name="mid_port_thruster_link"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            <specs thrust_coeff="350.0" torque_coeff="0.01" max_rpm="4000.0"/>

            <propeller diameter="0.08" right="true">
                <mesh filename="parts/thruster/prop.obj" scale="1.0"/>
                <material name="Resin"/>
                <look name="red"/>
            </propeller>
            <mass value="0.1"/>
        </actuator>

        <actuator name="ThrusterMidStarboard" type="propeller">
            <link name="mid_starboard_thruster_link"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            <specs thrust_coeff="350.0" torque_coeff="0.01" max_rpm="4000.0"/>
            <propeller diameter="0.08" right="true">
                <mesh filename="parts/thruster/prop.obj" scale="1.0"/>
                <material name="Resin"/>
                <look name="red"/>
            </propeller>
            <mass value="0.1"/>
        </actuator>




        <!-- rudders -->
        <!-- option1: using servo motor -->
        <!-- <link name="stern_rudder_link" type="box" physics="submerged">
            <dimensions xyz="0.01 0.02 0.01"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <material name="Neutral"/>
            <look name="Green"/>
        </link>

         <actuator name="RudderStern" type="rudder">
            <specs lift_coeff="0.5" drag_coeff="0.1" max_angle="3.0" area="0.1" stall_angle="0.9" max_angular_rate="2.0" inverted="false"/>
            <visual>
                <mesh filename="parts/others/rudder.obj" scale="0.008"/>
                <material name="Neutral"/>
                <look name="red"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </visual>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/> 
            <link name="stern_rudder_link"/>
        </actuator>


        <joint name="stern_rudder_servo_joint" type="revolute">
            <parent name="Base"/>
            <child name="stern_rudder_link"/>
            <origin rpy="0.0 0.0 0.0" xyz="-0.86 0.0 0.0"/> 
            <axis xyz="0.0 0.0 1.0"/>
            <limits min="-3.14" max="3.14"/>   
        </joint>

        
        <actuator name="stern_rudder_servo" type="servo"> 
            <joint name="stern_rudder_servo_joint"/> 
            <controller position_gain="1.0" velocity_gain="1.0" max_torque="2.0" max_velocity="0.5"/>
            <initial position="0.0"/>
        </actuator>  -->
        

        <!-- option2: using actuator -->

        <!-- <actuator name="stern_rudder_joint" type="rudder">
            <specs lift_coeff="0.5" drag_coeff="0.1" max_angle="3.0" area="0.05" stall_angle="0.9" max_angular_rate="2.0" inverted="false"/>
            <visual>
                <mesh filename="parts/others/rudder.obj" scale="0.008"/>
                <material name="Neutral"/>
                <look name="red"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </visual>
            <origin rpy="3.1415926 0.0 0.0" xyz="-0.86 0.0 0.1"/> 
            <link name="Base"/>
        </actuator> -->


        <!-- ################################################################### -->

        <!-- sensors -->
        <sensor name="gps" type="gps" rate="1.0">
            <link name="Base"/>
            <origin rpy="0.0 0.0 0.0" xyz="-0.35 0.0 -0.4"/>
            <noise ned_position="0.0"/>
            <ros_publisher topic="/$(arg robot_name)/gps/fix"/>
        </sensor>

         <sensor name="imu_sf" type="imu" rate="20.0">
                <link name="Base"/>
                <origin rpy="3.1415926 0.0 0.0" xyz="-0.4 0.0 -0.1"/>
                <noise angle="0.0001 0.0001 0.0001" angular_velocity="0.0001" yaw_drift="0.0001" linear_acceleration="0.0001"/>
                <ros_publisher topic="/$(arg robot_name)/imu/stonefish/data"/>
        </sensor>

        <sensor name="pressure" type="pressure" rate="5.0">
                <link name="Base"/>
                <origin rpy="0.0 0.0 0.0" xyz="-0.7 0.0 0.0"/>
                <noise pressure="2.0"/>
                <ros_publisher topic="/$(arg robot_name)/pressure"/>
        </sensor>

        <sensor name="dvl_sf" type="dvl" rate="5.0">
            <link name="Base"/>
            <origin rpy="3.1415926 0.0 0.0" xyz="-0.5 0.0 0.0"/>
            <specs beam_angle="30.0"/>
            <range velocity="9.0 9.0 9.0" altitude_min="0.2" altitude_max="200.0"/>
            <noise velocity="0.0" altitude="0.00"/>
            <ros_publisher topic="/$(arg robot_name)/dvl/stonefish/raw" altitude_topic="/$(arg robot_name)/dvl/stonefish/altitude"/>
        </sensor>

        <world_transform xyz="0.0 0.0 0.5" rpy="0.0 0.0 0.0"/>


        <ros_subscriber 
            servos="$(arg robot_name)/stonefish/servo/desired_joint_states" 
            propellers="$(arg robot_name)/stonefish/thruster_command"
        /> 
		<ros_publisher  
            servos="$(arg robot_name)/stonefish/servo/joint_states" 
            propellers="$(arg robot_name)/stonefish/thruster_state"
        />
            <!-- rudders = "$(arg robot_name)/stonefish/rudder/desired_joint_states" -->
            <!-- rudders = "$(arg robot_name)/stonefish/rudder/joint_state" -->

    </robot>
</scenario>