<?xml version="1.0"?>
<scenario>
    <robot name="$(arg robot_name)" fixed="false" self_collisions="false">
        <base_link name="Vehicle" type="compound" physics="submerged">
        
            <external_part name="Hull" type="model" physics="submerged" buoyant="false">
                <physical>
                    <mesh filename="parts/body/narwhal_hull.obj" scale="0.001"/>
                    <origin rpy="3.1415926 0.0 0.0" xyz="-0.5 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="parts/body/narwhal_hull.obj" scale="0.001"/>
                    <origin rpy="3.1415926 0.0 0.0" xyz="-0.5 0.0 0.0"/>
                </visual>
                <material name="Neutral"/>
                <look name="yellow"/>
                <mass value="16.7"/>
                <compound_transform rpy="0.0 0.0 3.1415926" xyz="0.0 0.0 0.0"/>
                <cg xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
            </external_part>
            
            <!-- <internal_part name="weights" type="model" physics="surface" buoyant="false">
                <physical>
                    <mesh filename="parts/others/narwhal_weight.obj" scale="1.0"/>
                    <origin rpy="3.1415926 0.0 0.0"  xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="parts/others/narwhal_weight.obj" scale="1.0"/>
                    <origin rpy="3.1415926 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Neutral"/>
                <look name="red"/>
                <mass value="2.85"/>
                <cg xyz="0.125 0.0 0.05" rpy="0.0 0.0 0.0"/> -->

                <!-- diving -->
                <!-- <compound_transform rpy="0.0 0.0 0.0" xyz="-0.1 0.0 0.0"/> -->
                <!-- climbing -->
                <!-- <compound_transform rpy="0.0 0.0 0.0" xyz="-0.25 0.0 0.0"/> -->
                <!-- float mode  -->
                <!-- -0.25 is the max -->
                <!-- <compound_transform rpy="3.1415926 0.0 0.0" xyz="-0.25 0.0 0.0"/> -->

            <!-- </internal_part> -->
            
            <internal_part name="Foam" type="cylinder" physics="floating" buoyant="true">
                <dimensions radius="0.075" height="1.14"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                <material name="Foam"/>
                <mass value="0.48"/>
                <look name="grey"/>
                <compound_transform rpy="0.0 1.57079 0.0" xyz="0.0 0.0 0.0"/>
            </internal_part>

            <external_part name="docking_nose" type="model" physics="submerged">
                <physical>
                    <mesh filename="parts/others/front_nose.obj" scale="0.001"/>
                    <origin rpy="0.0 -1.57079 0.0"  xyz="-0.45 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="parts/others/front_nose.obj" scale="0.001"/>
                    <origin rpy="0.0 -1.57079 0.0" xyz="-0.45 0.0 0.0"/>
                </visual>
                <material name="Neutral"/>
                <look name="red"/>
                <compound_transform rpy="0.0 0.0 3.1415926" xyz="0.0 0.0 0.0"/>
            </external_part>
        </base_link>


    <!-- internal weight adjustment -->
         <link name="adjustable_weight_link" type="compound" physics="surface">
            <external_part name="weights" type="model" physics="surface" buoyant="false">
                <physical>
                    <mesh filename="parts/others/narwhal_weight.obj" scale="1.0"/>
                    <origin rpy="3.1415926 0.0 0.0"  xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="parts/others/narwhal_weight.obj" scale="1.0"/>
                    <origin rpy="3.1415926 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Neutral"/>
                <look name="red"/>
                <mass value="2.85"/>

                <cg xyz="0.125 0.0 0.05" rpy="0.0 0.0 0.0"/>
                <compound_transform rpy="0.0 0.0 0.0" xyz="-0.1 0.0 0.0"/>
            </external_part>
        </link>

         <joint name="adjustable_weight_joint" type="revolute">
            <parent name="Vehicle"/>
            <child name="adjustable_weight_link"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            <axis xyz="1.0 0.0 0.0"/>
            <limits min="-3.1400000" max="3.1400000"/>    
        </joint>

   
        <actuator name="Servo" type="servo">
            <controller position_gain="1.0" velocity_gain="1.0" max_torque="30.0" max_velocity="10.0"/>
            <joint name="adjustable_weight_joint"/>
            <initial position="0.0"/>
        </actuator>
        
<!-- ###########Thrusters ######### -->

        <!-- surge thruster -->

        <actuator name="ThrusterSurge" type="propeller">
                <link name="Vehicle"/>
                <origin rpy="0.0 0.0 0.0" xyz="-0.72 0.0 0.0"/>
                <specs thrust_coeff="278.0" torque_coeff="0.01" max_rpm="3000.0"/>
                <propeller diameter="0.1145" right="true">
                    <origin rpy="1.57079 0.0 0.0" xyz="0.0 0.0 0.0"/>
                    <mesh filename="parts/thruster/prop.obj" scale="1.0"/>
                    <mesh filename="prop.obj" scale="1.5"/>
                    <material name="Neutral"/>
                    <look name="red"/>
                </propeller>
        </actuator>


        <actuator name="ThrusterHeavePort" type="propeller">
            <link name="Vehicle"/>
            <origin rpy="0.0 1.571 0.0" xyz="-0.376 -0.05 0.05"/>
            <specs thrust_coeff="286.7" torque_coeff="0.01" max_rpm="3000.0"/>
            <propeller diameter="0.08" right="true">
                <mesh filename="parts/thruster/prop.obj" scale="1.0"/>
                <mesh filename="prop.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="red"/>
            </propeller>
        </actuator>

        <actuator name="ThrusterHeaveStbd" type="propeller">
            <link name="Vehicle"/>
            <origin rpy="0.0 1.571 0.0" xyz="-0.376 0.05 0.05"/>
            <specs thrust_coeff="286.7" torque_coeff="0.01" max_rpm="3000.0"/>
            <propeller diameter="0.08" right="true">
                <mesh filename="parts/thruster/prop.obj" scale="1.0"/>
                <mesh filename="prop.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="red"/>
            </propeller>
        </actuator>

        <actuator name="ThrusterSway" type="propeller">
            <link name="Vehicle"/>
            <origin rpy="0.0 0.0 -1.5707963" xyz="-0.5194 0.0 0.045"/>
            <specs thrust_coeff="286.7" torque_coeff="0.01" max_rpm="3000.0"/>
            <propeller diameter="0.08" right="true">
                <mesh filename="parts/thruster/prop.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="red"/>
            </propeller>
        </actuator>

        <world_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>

        <ros_subscriber servos="$(arg robot_name)/stonefish/servo/desired_joint_states"/> 
		<ros_publisher  servos="$(arg robot_name)/stonefish/servo/joint_states"/>
        
        <ros_subscriber propellers="$(arg robot_name)/stonefish/thruster_command"/> 
		<ros_publisher propellers="$(arg robot_name)/stonefish/thruster_state"/>
    </robot>
</scenario>