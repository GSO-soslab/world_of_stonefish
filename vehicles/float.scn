<scenario>
    <robot name="$(arg robot_name)" fixed="false" self_collisions="false">
        <base_link name="Vehicle" type="compound" physics="submerged">
            <!-- TODO: buoyant ? -->
            <external_part name="Hull" type="model" physics="submerged" buoyant="true">
                <physical>
                    <mesh filename="parts/body/float_body.obj" scale="0.001"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="parts/body/float_body.obj" scale="0.001"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Vehicle"/>
                <look name="yellow"/>
                <!-- TODO: mass ? -->
                <!-- <mass value="25"/> -->
                <compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                <cg xyz="0.0 0.0 0.0" rpy="1.5707 0.0 0.0"/>
            </external_part>

            <internal_part name="Foam" type="cylinder" physics="floating" buoyant="true">
                <dimensions radius="0.1" height="0.2"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                <material name="Foam"/>
                <mass value="2.15"/>
                <look name="grey"/>
                <compound_transform rpy="0.0 0.0 0.0" xyz="-0.2 0.0 0.0"/>
            </internal_part>

            <internal_part name="Aluminium" type="cylinder" physics="floating" buoyant="true">
                <dimensions radius="0.1" height="0.075"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                <material name="Aluminium"/>
                <inertia xyz="0.065 0.205 0.205"/>
                <look name="grey"/>
                <compound_transform rpy="0.0 0.0 0.0" xyz="0.2 0.0 0.0"/>
            </internal_part>
            
            <!-- thruster duct -->
            <external_part name="ThrusterDuctPort" type="model" physics="submerged" buoyant="true">
                <physical>
                    <mesh filename="parts/thruster/duct_reduced.obj" scale="0.001"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="parts/thruster/duct.obj" scale="0.001"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Neutral"/>
                <look name="black"/>
                <!-- <compound_transform rpy="0.0 -1.57 0.0" xyz="-0.2 -0.11 0.0"/> -->
                <compound_transform rpy="0.0 -1.57 0.0" xyz="-0.1 -0.11 0.0"/>
            </external_part>

            <external_part name="ThrusterDuctStbd" type="model" physics="submerged" buoyant="true">
                <physical>
                    <mesh filename="parts/thruster/duct_reduced.obj" scale="0.001"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="parts/thruster/duct.obj" scale="0.001"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Neutral"/>
                <look name="black"/>
                <!-- <compound_transform rpy="0.0 -1.57 0.0" xyz="-0.2 0.11 0.0"/> -->
                <compound_transform rpy="0.0 -1.57 0.0" xyz="-0.1 0.11 0.0"/>
            </external_part>

        </base_link>

        <!-- TODO: need a base link? -->
        <!-- <link name="Base" type="box" physics="submerged">
            <dimensions xyz="0.01 0.02 0.01"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <material name="Neutral"/>
            <look name="Green"/>
        </link>


        <joint name="Joint1" type="fixed">
            <parent name="Vehicle"/>
            <child name="Base"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <axis xyz="1.0 0.0 0.0"/>
        </joint> -->
            
        <actuator name="ThrusterHeavePort" type="propeller">
            <link name="Vehicle"/>
            <origin rpy="0.0 0.0 0.0" xyz="-0.1 -0.11 0.0"/>
            <specs thrust_coeff="0.4315" thrust_coeff_backward="0.3404" torque_coeff="0.01" max_rpm="3000.0"/>
            <propeller diameter="0.08" right="true">
                <mesh filename="parts/thruster/prop.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="white"/>
            </propeller>
        </actuator>

        <actuator name="ThrusterHeaveStbd" type="propeller">
            <link name="Vehicle"/>
            <origin rpy="0.0 0.0 0.0" xyz="-0.1 0.11 0.0"/>
            <specs thrust_coeff="0.4315" thrust_coeff_backward="0.3404" torque_coeff="0.01" max_rpm="3000.0"/>
            <propeller diameter="0.08" right="true">
                <mesh filename="parts/thruster/prop.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="white"/>
            </propeller>
        </actuator>

        <sensor name="pressure" type="pressure" rate="5.0">
            <link name="Vehicle"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.05 0.0 0.0"/>
            <noise pressure="2.0"/>
            <ros_publisher topic="$(arg robot_name)/stonefish/pressure"/>
        </sensor>

        <sensor name="gps" type="gps" rate="1.0">
            <link name="Vehicle"/>
            <origin rpy="0.0 0.0 0.0" xyz="-0.63 0.0 -0.1"/>
            <noise ned_position="0.0"/>
            <ros_publisher topic="$(arg robot_name)/stonefish/gps/fix"/>
        </sensor>

        <sensor name="imu_sf" type="imu" rate="100.0">
            <link name="Vehicle"/>
            <!-- TODO: the imu not on the vehilce frame even on "0", maybe the obj file issue -->
            <origin rpy="0.0 1.5707 0.0" xyz="-0.17 0.0 0.0"/>
            <noise angle="0.0001 0.0001 0.0001" angular_velocity="0.0001" yaw_drift="0.0001" linear_acceleration="0.0001"/>
            <ros_publisher topic="$(arg robot_name)/stonefish/imu/data"/>
        </sensor>

        <!-- TODO: add USBL -->
        <!-- <comm name="usbl" device_id="1" type="usbl">
            <specs min_vertical_fov="0.0" max_vertical_fov="360.0" range="1000.0"/>
            <connect device_id="2" occlusion_test="false"/>
            <autoping rate="1.0"/>
            <noise range="0.05" horizontal_angle="0.2" vertical_angle="0.5"/>
            <resolution range="0.1" angle="0.1"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <link name="Base"/>
            <ros_publisher topic="$(arg robot_name)/stonefish/usbl"/>
        </comm> -->

        <!-- TODO: add odometry -->

        <world_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>

        <ros_subscriber propellers="$(arg robot_name)/stonefish/thruster_command"/> 
		<ros_publisher propellers="$(arg robot_name)/stonefish/thruster_state"/>

    </robot>

</scenario>