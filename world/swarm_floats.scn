<?xml version="1.0"?>

<scenario>
	<environment>
		<ned latitude="41" longitude="-71"/>
		<ocean>
			<water density="1023.0" jerlov="0.2"/>
			<!-- <waves height="0.5"/> -->
			<particles enabled="true"/>
			<current type="uniform">
				<!-- <velocity xyz="0.01 0.005 0.0"/> -->
				<velocity xyz="0.05 0.05 0.0"/>
			</current>
		</ocean>
		<atmosphere>
			<sun azimuth="40.0" elevation="10.0"/>
		</atmosphere>
	</environment>


	<include file="$(find world_of_stonefish)/metadata/materials.scn"/>
	<include file="$(find world_of_stonefish)/metadata/looks.scn"/>

	<include file="$(find world_of_stonefish)/vehicles/float_1.scn">
		<arg name="robot_name"      value="float_rise_1"/>

		<!-- float 1 (USBL) and float 2 (Acomm) -->
		<arg name="comm_device_id_1"  value="1"/>
		<arg name="comm_connect_id_1" value="2"/>

		<!-- float 1 (USBL) and float 3 (Acomm) -->
		<arg name="comm_device_id_2"  value="3"/>
		<arg name="comm_connect_id_2" value="4"/>

		<!-- float 2 (USBL) and float 1 (Acomm) -->
		<arg name="comm_device_id_3"  value="6"/>
		<arg name="comm_connect_id_3" value="5"/>

		<!-- float 3 (USBL) and float 1 (Acomm) -->
		<arg name="comm_device_id_4"  value="10"/>
		<arg name="comm_connect_id_4" value="9"/>

		<arg name="position_x"      value="0.0"/>
		<arg name="position_y"      value="0.0"/>
		<arg name="position_z"      value="0.0"/>
	</include>

	<include file="$(find world_of_stonefish)/vehicles/float_2.scn">
		<arg name="robot_name" value="float_rise_2"/>

		<!-- float 1 (USBL) and float 2 (Acomm) -->
		<arg name="comm_device_id_1"  value="2"/>
		<arg name="comm_connect_id_1" value="1"/>

		<!-- float 2 (USBL) and float 1 (Acomm) -->
		<arg name="comm_device_id_2"  value="5"/>
		<arg name="comm_connect_id_2" value="6"/>

		<!-- float 2 (USBL) and float 3 (Acomm) -->
		<arg name="comm_device_id_3"  value="7"/>
		<arg name="comm_connect_id_3" value="8"/>

		<!-- float 3 (USBL) and float 2 (Acomm) -->
		<arg name="comm_device_id_4"  value="12"/>
		<arg name="comm_connect_id_4" value="11"/>

		<arg name="position_x" value="5.0"/>
		<arg name="position_y" value="-2.0"/>
		<arg name="position_z" value="0.0"/>
	</include>

	<include file="$(find world_of_stonefish)/vehicles/float_3.scn">
		<arg name="robot_name" value="float_rise_3"/>

		<!-- float 1 (USBL) and float 3 (Acomm) -->
		<arg name="comm_device_id_1"  value="4"/>
		<arg name="comm_connect_id_1" value="3"/>
				
		<!-- float 2 (USBL) and float 3 (Acomm) -->
		<arg name="comm_device_id_2"  value="8"/>
		<arg name="comm_connect_id_2" value="7"/>

		<!-- float 3 (USBL) and float 1 (Acomm) -->
		<arg name="comm_device_id_3"  value="9"/>
		<arg name="comm_connect_id_3" value="10"/>

		<!-- float 3 (USBL) and float 2 (Acomm) -->
		<arg name="comm_device_id_4"  value="11"/>
		<arg name="comm_connect_id_4" value="12"/>

		<arg name="position_x" value="-5.0"/>
		<arg name="position_y" value="-4.0"/>
		<arg name="position_z" value="0.0"/>
	</include>	

	<static name="Bottom" type="model">
        <physical>
            <mesh filename="objects/flat_terrain.obj" scale="10.0" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <visual>
            <mesh filename="objects/flat_terrain.obj" scale="10.0"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </visual>
        <material name="Rock"/>
        <look name="Gray"/>
        <world_transform xyz="0.0 0.0 20.0" rpy="0.0 0.0 0.0"/>
    </static>


</scenario>