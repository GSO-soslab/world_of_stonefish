<?xml version="1.0"?>

<scenario>
	<arg name="robot_name"         default="race_station_light"/>
	<arg name="density"            default="1023.0"/>
	<arg name="jerlov"             default="0.2"/>
	<arg name="temperature"        default="15.0"/>
	<arg name="wave_height"        default="0.0"/>
	<arg name="particles_enabled"  default="true"/>
	<arg name="uniform_current"    default="0.0 0.0 0.0"/>
	<arg name="sun_azimuth"        default="40.0"/>
	<arg name="sun_elevation"      default="10.0"/>
	<arg name="station_xyz"        default="0.0 0.0 2.0"/>
	<arg name="station_rpy"        default="0.0 0.0 0.0"/>
	<arg name="bottom_xyz"         default="0.0 0.0 40.0"/>

	<environment>
		<ned latitude="41" longitude="-71"/>
		<ocean>
			<water density="$(arg density)" jerlov="$(arg jerlov)" temperature="$(arg temperature)"/>
			<waves height="$(arg wave_height)"/>
			<particles enabled="$(arg particles_enabled)"/>
			<current type="uniform">
				<velocity xyz="$(arg uniform_current)"/>
			</current>
		</ocean>
		<atmosphere>
			<sun azimuth="$(arg sun_azimuth)" elevation="$(arg sun_elevation)"/>
		</atmosphere>
	</environment>

	<include file="$(find world_of_stonefish)/metadata/materials.scn"/>
	<include file="$(find world_of_stonefish)/metadata/looks.scn"/>

	<include file="$(find world_of_stonefish)/vehicles/race_station_light.scn">
		<arg name="robot_name" value="$(arg robot_name)"/>
		<arg name="world_xyz"  value="$(arg station_xyz)"/>
		<arg name="world_rpy"  value="$(arg station_rpy)"/>
	</include>

	<static name="Bottom" type="model">
        <physical>
            <mesh filename="objects/flat_terrain.obj" scale="10.0" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <visual>
            <mesh filename="objects/flat_terrain.obj" scale="10.0"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </visual>
        <material name="Rock"/>
        <look name="Gray"/>
        <world_transform xyz="$(arg bottom_xyz)" rpy="0.0 0.0 0.0"/>
    </static>

    <!-- Animated moving frame carrying the dwe_camera and an odometry sensor.
         Trajectory uses placeholder keypoints around the docking station. -->
    <animated name="camera" type="empty">
        <!-- <trajectory type="pwl" playback="repeat">
