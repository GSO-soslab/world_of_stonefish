<?xml version="1.0"?>

<scenario>
	<environment>
		<ned latitude="41" longitude="-71"/>
		<ocean>
			<water density="1023.0" jerlov="0.2"/>
		</ocean>
		<atmosphere>
			<sun azimuth="40.0" elevation="10.0"/>
		</atmosphere>
	</environment>
	
	<include file="$(find world_of_stonefish)/metadata/materials.scn"/>
	<include file="$(find world_of_stonefish)/metadata/looks.scn"/>
	<include file="$(find world_of_stonefish)/vehicles/race_auv.scn">
		<arg name="robot_name" value="race_auv"/>
	</include>

	<robot name="DockingStation" fixed="true" self_collisions="false">
		<base_link name="Station" type="compound" physics="submerged">
			<external_part name="Body" type="model" physics="submerged" buoyant="false">
				<physical>
					<mesh filename="objects/RACE_station_flat.obj" scale="0.011" convex="false"/>
					<origin xyz="0.0 0.0 0.0" rpy="3.1415 0.0 1.57"/>
				</physical>
				<visual>
					<mesh filename="objects/RACE_station_flat.obj" scale="0.011"/>
					<origin xyz="0.0 0.0 0.0" rpy="3.1415 0.0 1.57"/>
				</visual>
				<material name="Rock"/>
				<look name="Gray"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</external_part>
		</base_link>

		<link name="UsblLink" type="box" physics="disabled">
			<dimensions xyz="0.001 0.001 0.001"/>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<material name="Neutral"/>
			<look name="Green"/>
		</link>

		<joint name="Joint1" type="fixed">
			<parent name="Station"/>
			<child name="UsblLink"/>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<axis xyz="0.0 0.0 0.0"/>
		</joint>

		<link name="ApriltagLink" type="box" physics="disabled">
			<dimensions xyz="0.21 0.21 0.001"/>
			<origin xyz="0.4 0.4 0.545" rpy="0.0 0.0 0.0"/>
			<material name="Steel"/>
			<look name="apriltag0" uv_mode="1"/>
		</link>

		<joint name="ApriltagJoint" type="fixed">
			<parent name="Station"/>
			<child name="ApriltagLink"/>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<axis xyz="0.0 0.0 0.0"/>
		</joint>

		<comm name="usbl" device_id="2" type="usbl">
			<specs min_vertical_fov="0.0" max_vertical_fov="360.0" range="1000.0"/>
			<connect device_id="1" occlusion_test="false"/>
			<autoping rate="1.0"/>
			<noise range="0.05" horizontal_angle="0.2" vertical_angle="0.5"/>
			<resolution range="0.1" angle="0.1"/>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<link name="UsblLink"/>
			<!-- <ros_publisher topic="race_top/stonefish/usbl"/>
			<ros_subscriber  topic="race_top/stonefish/usbl"/> -->
            <ros_publisher topic="race_top/stonefish/acomms"/>
            <ros_subscriber topic="race_top/stonefish/acomms"/>
		</comm>

		<!-- <world_transform xyz="-1.0 -0.365 0.0" rpy="0.0 0.0 0.0"/> -->
		<world_transform xyz="0.0 0.0 1.0" rpy="0.0 0.0 0.0"/>

	</robot>

	<static name="Bottom" type="model">
        <physical>
            <mesh filename="objects/flat_terrain.obj" scale="10.0" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <visual>
            <mesh filename="objects/flat_terrain.obj" scale="10.0"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </visual>
        <material name="Rock"/>
        <look name="Gray"/>
        <world_transform xyz="0.0 0.0 40.0" rpy="0.0 0.0 0.0"/>
    </static>

</scenario>