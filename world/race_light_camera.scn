<?xml version="1.0"?>

<scenario>
	<arg name="robot_name"         default="race_light_camera"/>
	<arg name="density"            default="1023.0"/>
	<arg name="jerlov"             default="0.2"/>
	<arg name="temperature"        default="15.0"/>
	<arg name="wave_height"        default="0.0"/>
	<arg name="particles_enabled"  default="true"/>
	<arg name="uniform_current"    default="0.0 0.0 0.0"/>
	<arg name="sun_azimuth"        default="0.0"/>
	<arg name="sun_elevation"      default="90.0"/>

	<environment>
		<ned latitude="41" longitude="-71"/>
		<ocean>
			<water density="$(arg density)" jerlov="$(arg jerlov)" temperature="$(arg temperature)"/>
			<waves height="$(arg wave_height)"/>
			<particles enabled="false"/>
			<current type="uniform">
				<velocity xyz="$(arg uniform_current)"/>
			</current>
		</ocean>
		<atmosphere>
			<sun azimuth="0.0" elevation="90.0"/>
		</atmosphere>
	</environment>

	<include file="$(find world_of_stonefish)/metadata/materials.scn"/>
	<include file="$(find world_of_stonefish)/metadata/looks.scn"/>

	<!-- Minimal mount for the docking spot light. Same physical LED spec
	     as race_station_light.scn: 1500 lm, 5700 K, 135 deg beam. -->
	<robot name="$(arg robot_name)" fixed="true" self_collisions="false">
		<base_link name="LightMount" type="box" physics="submerged">
			<dimensions xyz="0.01 0.01 0.01"/>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<material name="Neutral"/>
			<look name="MatteGray"/>
		</base_link>

		<light name="DockingSpot">
			<specs radius="0.0185" cone_angle="135.0" illuminance="10000.0"/>
			<color temperature="5700.0"/>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 -1.5707963 0.0"/>
			<link name="LightMount"/>
		</light>

		<world_transform xyz="0.0 0.0 5.0" rpy="0.0 0.0 0.0"/>
	</robot>

	<!-- Animated camera frame with placeholder trajectory. -->
	<animated name="DweCam" type="empty">
		<!-- <trajectory type="pwl" playback="boomerang">
			<keypoint time="0.0" xyz="-1.0 0.0 5.0" rpy="0.0 0.0 0.0"/>
			<keypoint time="10.0" xyz="-1.0 1.0 5.0" rpy="0.0 0.0 0.0"/>
		</trajectory> -->
