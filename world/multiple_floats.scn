<?xml version="1.0"?>

<scenario>
	<environment>
		<ned latitude="41" longitude="-71"/>
		<ocean>
			<water density="1023.0" jerlov="0.2"/>
			<!-- <waves height="0.5"/> -->
			<particles enabled="true"/>
			<current type="uniform">
				<!-- <velocity xyz="0.01 0.005 0.0"/> -->
				<velocity xyz="0.05 0.05 0.0"/>
			</current>
		</ocean>
		<atmosphere>
			<sun azimuth="40.0" elevation="10.0"/>
		</atmosphere>
	</environment>

	<include file="$(find world_of_stonefish)/metadata/materials.scn"/>
	<include file="$(find world_of_stonefish)/metadata/looks.scn"/>

	<static name="Bottom" type="model">
        <physical>
            <mesh filename="objects/flat_terrain.obj" scale="10.0" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <visual>
            <mesh filename="objects/flat_terrain.obj" scale="10.0"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </visual>
        <material name="Rock"/>
        <look name="Gray"/>
        <world_transform xyz="0.0 0.0 100.0" rpy="0.0 0.0 0.0"/>
    </static>

	<!-- Multiple Floats -->
	
	<!-- No. 1 -->
	<include file="$(find world_of_stonefish)/vehicles/float.scn">
		<arg name="robot_name" value="float_rise_1"/>
		<arg name="position_x" value="0.0"/>
		<arg name="position_y" value="0.0"/>
		<arg name="position_z" value="0.0"/>
	</include>

	<!-- No. 2 -->
	<include file="$(find world_of_stonefish)/vehicles/float.scn">
		<arg name="robot_name" value="float_rise_2"/>
		<arg name="position_x" value="5.0"/>
		<arg name="position_y" value="-2.0"/>
		<arg name="position_z" value="0.0"/>
	</include>

	<!-- No. 3 -->
	<include file="$(find world_of_stonefish)/vehicles/float.scn">
		<arg name="robot_name" value="float_rise_3"/>
		<arg name="position_x" value="-5.0"/>
		<arg name="position_y" value="-4.0"/>
		<arg name="position_z" value="0.0"/>
	</include>

</scenario>